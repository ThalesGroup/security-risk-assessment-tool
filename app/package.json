{
    "name": "sratool",
    "version": "1.3.0-beta04",
    "author": "Thales DIS",
    "license": "BSD-4-Clause",
    "description": "Security Risk Assessment tool",
    "main": "./src/electron/main.js",
    "engines": {
        "node": ">=26.3.1"
    },
    "scripts": {
        "start": "electron .",
        "test": "playwright test",
        "prod-lib": "node prepare-prod-lib.js",
        "pack": "npm run prod-lib && electron-builder --dir",
        "dist": "npm run prod-lib && electron-builder",
        "dist-all": "npm run prod-lib && electron-builder -mwl",
        "build-dis": "npm run prod-lib && export QUALIFIER=-DIS && electron-builder -mwl",
        "build-oss": "npm run prod-lib && export QUALIFIER='' && electron-builder -mwl",
        "dist-linux": "npm run prod-lib && electron-builder -l",
        "dist-mac": "npm run prod-lib && electron-builder -m",
        "dist-windows": "npm run prod-lib && electron-builder -w"
    },
    "build": {
        "afterPack": "./set-build-timestamp.cjs",
        "afterAllArtifactBuild": "./set-build-timestamp.cjs",
        "fileAssociations": [
            {
                "ext": "sra",
                "description": "ISRA File",
                "role": "Editor"
            },
            {
                "ext": "xml",
                "description": "XML File",
                "role": "Editor"
            }
        ],
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "allowToChangeInstallationDirectory": true,
            "artifactName": "${name}-setup-${version}-${os}-${arch}${env.QUALIFIER}.${ext}"
        },
        "artifactName": "${name}-${version}-${os}-${arch}${env.QUALIFIER}.${ext}",
        "extraResources": [
            {
                "from": "../lib",
                "to": "lib",
                "filter": [
                    "**/*",
                    "!**/node_modules",
                    "!**/test/**",
                    "!**/coverage/**",
                    "!**/.npmrc",
                    "!**/eslint.config.js"
                ]
            },
            {
                "from": "../.lib-prod/node_modules",
                "to": "lib/node_modules",
                "filter": [
                    "**/*",
                    "!**/.bin"
                ]
            }
        ],
        "mac": {
            "icon": "src/asset/isra-app-icon-512.png",
            "category": "public.app-category.business",
            "target": [
                {
                    "target": "zip",
                    "arch": "x64"
                },
                {
                    "target": "tar.gz",
                    "arch": "arm64"
                }
            ]
        },
        "win": {
            "icon": "src/asset/isra-app-icon-512.png",
            "target": [
                {
                    "target": "zip",
                    "arch": "x64"
                },
                {
                    "target": "nsis",
                    "arch": "x64"
                }
            ]
        },
        "linux": {
            "icon": "src/asset/isra-app-icon-512.png",
            "target": [
                {
                    "target": "tar.gz",
                    "arch": "x64"
                },
                {
                    "target": "AppImage",
                    "arch": "x64"
                }
            ]
        },
        "appId": "com.thalesgroup.dis.sratool"
    },
    "dependencies": {
        "chart.js": "^4.3.2",
        "jquery": "^3.6.1",
        "hugerte": "^1.0.11",
        "tabulator-tables": "^5.3.4",
        "xml2js": "^0.6.2"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "electron": "^42.5.0",
        "electron-builder": "^26.15.3"
    },
    "overrides": {
        "got": "^11.8.5",
        "form-data": "^4.0.5",
        "js-yaml": "^4.3.2",
        "glob": "^13.0.6",
        "tmp": "^0.2.5",
        "brace-expansion": "^5.0.9",
        "fast-uri": "^3.1.6",
        "tar": "^7.5.21",
        "@xmldom/xmldom": "^0.8.15",
        "app-builder-lib": {
            "@noble/hashes": "^1.8.0",
            "undici": "^7.29.0"
        }
    }
}